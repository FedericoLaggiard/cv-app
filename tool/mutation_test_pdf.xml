<?xml version="1.0" encoding="UTF-8"?>
<!-- Configurazione del mutation testing notturno per le euristiche di import
     (ticket 22, perimetro esteso col ticket 53 - vedi l'amendment in
     docs/cv-app/issues/22-mutation-testing-notturno.md).

     Perimetro: il solo `pdf_import_heuristics.dart`. E' l'unico modulo fuori
     da lib/src/domain/ che soddisfa il criterio del ticket 22 ("logica pura,
     ben isolata"): niente Flutter, niente pdfrx, testabile da solo. Il resto
     di lib/src/pdf/ e' rendering con dipendenze Flutter, fuori perimetro come
     i widget.

     Config separata da tool/mutation_test.xml e non aggiunta al suo <files>:
     i due perimetri hanno suite di test diverse, e un solo file di config
     costringerebbe ogni mutante del dominio a pagare anche la suite pdf (e
     viceversa), raddoppiando i tempi senza aggiungere segnale.

     La soglia e' sostituita in CI dal valore della variable
     MUTATION_THRESHOLD_PDF (assente = 0 = run di baseline). -->
<mutations version="1.2">
  <files>
    <file>lib/src/pdf/pdf_import_heuristics.dart</file>
  </files>

  <commands>
    <!-- Solo i test che esercitano davvero questo modulo, non tutta test/pdf:
         attribuire l'uccisione di un mutante a un test dei template PDF
         falserebbe la lettura, esattamente come il ticket 22 dice per i
         widget test rispetto al dominio. -->
    <command group="test" expected-return="0" working-directory="." timeout="120">flutter test test/pdf/pdf_import_heuristics_test.dart test/pdf/conversion_rate_test.dart test/pdf/pdf_importer_test.dart test/pdf/no_lost_lines_test.dart</command>
  </commands>

  <exclude>
    <!-- Commenti e direttive: nessun comportamento osservabile. -->
    <token begin="//" end="\n"/>
    <regex pattern="/[*].*?[*]/" dotAll="true"/>
    <token begin="export &apos;" end="&apos;;"/>
    <token begin="import &apos;" end="&apos;;"/>
    <token begin="export &quot;" end="&quot;;"/>
    <token begin="import &quot;" end="&quot;;"/>

    <!-- Le raw string di questo modulo sono tutte pattern di RegExp. Mutarne
         il contenuto non produce segnale utile: o il pattern si rompe e il
         mutante muore per motivi che non dicono nulla sulla qualita' dei
         test, o resta equivalente e sopravvive abbassando lo score a vuoto.
         La logica che vogliamo misurare e' quella *attorno* ai match (voto,
         confini, fallback), non il contenuto delle regex. -->
    <regex pattern="r&apos;[^&apos;]*&apos;"/>

    <!-- Incremento e decremento producono quasi solo falsi positivi; i loop
         mutati non terminano. (Niente doppio trattino nei commenti: non e'
         XML valido.) -->
    <regex pattern="\+\+"/>
    <regex pattern="--"/>
    <regex pattern="[\s]for[\s]*\(.*?\)[\s]*{" dotAll="true"/>
    <regex pattern="[\s]while[\s]*\(.*?\)[\s]*{.*?}" dotAll="true"/>
  </exclude>

  <!-- SOGLIA: 0 = gate disattivato. Nasce a 0 di proposito: il dominio sta a
       75, ma un modulo pieno di fallback ("se non c'e' maggioranza, lascia
       vuoto") produce parecchi mutanti equivalenti, quindi il primo numero
       va misurato prima di trasformarlo in un gate. -->
  <threshold failure="0">
    <rating over="95" name="A"/>
    <rating over="80" name="B"/>
    <rating over="60" name="C"/>
    <rating over="40" name="D"/>
    <rating over="20" name="E"/>
    <rating over="0" name="F"/>
  </threshold>
</mutations>
